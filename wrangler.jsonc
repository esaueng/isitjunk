{
  "name": "isitjunk-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-07",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-5.5",
    "OPENROUTER_EXTRACT_MODEL": "openai/gpt-5.4-mini",
    "MAX_ANALYSES_PER_DAY": "200"
  },
  "send_email": [
    {
      "name": "REPORT_EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isitjunk_email",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": true
  }
}
